{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "offhand",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The Worker's address, <name>.<account>.workers.dev. Stated rather than left to the default:
  // a Worker made by Deploy to Cloudflare came up with it switched off.
  "workers_dev": true,
  // Variables set in the Cloudflare dashboard survive a deploy, and so an update.
  "keep_vars": true,
  "observability": { "enabled": true },
  // Holds the offhand token, Roma's sign-in and the time zone. Deploy to Cloudflare creates it;
  // by hand: `npx wrangler kv namespace create OFFHAND_KV` and paste the id here.
  "kv_namespaces": [{ "binding": "OFFHAND_KV", "id": "offhand_kv_placeholder" }]
  // No "vars" and no secrets here. Deploy to Cloudflare shows a box for every one it finds, and
  // none is needed: the defaults are in src/index.ts. To change one, set it in the Cloudflare
  // dashboard (the Worker, Settings, Variables and Secrets), not here: an update replaces this file.
  //   DEFAULT_LIST    where items go when no list is named; "tasks" by default
  //   TIME_ZONE       otherwise the browser's, from when Roma was connected
  //   SAY_MODEL, SAY_EFFORT, SAY_MAX_TOKENS    POST /say only
}
